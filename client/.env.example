# Copy to client/.env for local development, or set in the Vercel frontend project.
# Only VITE_* values reach the browser — never put database or JWT secrets here.

# Local development: /api is proxied to http://localhost:5000 by vite.config.js
VITE_API_URL=/api

# Production (Vercel frontend project):
# VITE_API_URL=https://4thsem-webdevelopment-projects.vercel.app/api
