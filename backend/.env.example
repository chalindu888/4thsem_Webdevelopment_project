# Copy to backend/.env for local development. In Vercel, add these as Environment Variables.
# Placeholders only — never commit real values.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Long random string used to sign login tokens, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<long-random-secret>

# development locally; production on Vercel
NODE_ENV=development

# Frontend origin(s) allowed by CORS; comma-separate several. No trailing slash.
FRONTEND_URL=https://4thsem-webdevelopment-project-c48i.vercel.app

# Local port only (Vercel ignores it)
PORT=5000
